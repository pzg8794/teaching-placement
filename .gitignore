.DS_Store
*.aux
*.bbl
*.fdb_latexmk
*.fls
*.log
*.out
*.toc
*.xdv
*.synctex.gz
~$*

# Keep private communications directory markdown-only in Git.
private/communications/*
!private/communications/*.md

# Keep lesson evidence directory markdown-only in Git.
private/lesson-evidence/*
!private/lesson-evidence/*.md

# Keep raw transcripts markdown-only in Git.
private/transcripts/*
!private/transcripts/*.md

# Keep compiled lesson PDFs only inside lesson packet artifacts folders.
private/lesson-packets/*/*/*.pdf
!private/lesson-packets/*/*/artifacts/*.pdf
