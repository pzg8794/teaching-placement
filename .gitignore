.DS_Store
*.aux
*.bbl
*.fdb_latexmk
*.fls
*.log
*.out
*.toc
*.xdv
*.synctex.gz
~$*

# Keep communications directory markdown-only in Git.
communications/*
!communications/*.md

# Keep lesson evidence directory markdown-only in Git.
lessons/evidence/*
!lessons/evidence/*.md

# Keep raw transcripts markdown-only in Git.
transcripts/*
!transcripts/*.md

# Keep compiled lesson PDFs only inside lesson artifacts folders.
lessons/*/*/*.pdf
!lessons/*/*/artifacts/*.pdf
!lessons/source-materials/*/*.pdf
